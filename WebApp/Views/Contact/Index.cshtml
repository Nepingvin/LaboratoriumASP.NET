@model List<ContactModel>

@{
ViewBag.Title = "Contact Page";
Layout = "_Layout";
}

<h2>
    Contacts
</h2>

<a class="btn btn-primary" asp-action="Add" asp-controller="Contact">Add Contact</a>
<h4>Contact List</h4>
@if(Model.Count > 0)
{
<table class="table">
    <thead>
    <tr>
        <th>
            @Html.DisplayNameFor(l => l[0].FirstName)
        </th>
        <th>
            @Html.DisplayNameFor(l => l[0].LastName)
        </th>
        <th>
            @Html.DisplayNameFor(l => l[0].Category)
        </th>
        <th>
            Action
        </th>
    </tr>
    </thead>
    <tbody>
    @foreach (var entry in Model)
    {
    <tr>
        <td>
            @entry.FirstName
        </td>
        <td>
            @entry.LastName
        </td>
        <td>
            @entry.Category.GetDisplayName()
        </td>
        <td>
            <div class="float-end">
                <a class="btn btn-success" asp-controller="Contact" asp-action="Edit" asp-route-id="@entry.Id">Edit</a>
                <a class="btn btn-info" asp-controller="Contact" asp-action="Details" asp-route-id="@entry.Id">Info</a>
                <a class="btn btn-danger" asp-controller="Contact" asp-action="Delete" asp-route-id="@entry.Id">Delete</a>
            </div>
        </td>
    </tr>
    }
    </tbody>
</table>
}
else
{
<h1 class="text-danger">
    Nie masz jeszcze kontaktow
</h1>
}